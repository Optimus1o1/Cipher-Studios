# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK Configuration (Server-side)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"

# Email notifications for new leads (Resend: https://resend.com)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Moon Sanctum Labs <hello@yourdomain.com>"
LEAD_NOTIFY_EMAIL=you@yourdomain.com
# Optional: random string used when hashing visitor IPs (so raw IPs are never stored)
IP_HASH_SALT=change_me
# Optional: booking link shown on the thank-you page (Cal.com or Calendly)
NEXT_PUBLIC_BOOKING_URL=

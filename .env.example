# Supabase PostgreSQL Configuration (Server-Side)
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret API Key (sb_secret_...): Keeps elevated database operations strictly server-side
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Upstash Redis Distributed Rate Limiter (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
# High-entropy 64-char hex secret for anonymizing client IP addresses via HMAC-SHA256
IP_HASH_SECRET=your_64_character_hex_secret_here

# Cloudflare Turnstile Bot Defense (https://dash.cloudflare.com/?to=/:account/turnstile)
# For local dev / CI testing, Cloudflare provides Always-Pass test keys:
# Site Key: 1x00000000000000000000AA | Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Transactional Email Alerts (Resend: https://resend.com)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Moon Sanctum Labs <notifications@moonsanctumlabs.design>"
LEAD_NOTIFY_EMAIL=notifications@moonsanctumlabs.design

# Optional: Booking link shown on the thank-you page (Cal.com or Calendly)
NEXT_PUBLIC_BOOKING_URL=

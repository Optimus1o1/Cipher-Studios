# CIPHER Studios — Environment Variables Configuration
# Copy this file to .env.local for local development

# ==============================================================================
# 1. Next.js Application Environment
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# 2. Firebase Client Configuration (Firebase Console -> Project Settings)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef12345678

# ==============================================================================
# 3. Firebase Admin SDK (Server-Side Only — NEVER expose to client)
# ==============================================================================
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key with escaped newlines (\n)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# 4. Email Notification (Resend API)
# ==============================================================================
RESEND_API_KEY=re_123456789_abcdef
CONTACT_NOTIFICATION_EMAIL=aniket@cipherstudios.dev

# ==============================================================================
# 5. Security & App Check (reCAPTCHA v3)
# ==============================================================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
